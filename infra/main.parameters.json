{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "deployOpenAIAudio": { "value": "${DEPLOY_OPENAI_AUDIO=false}" },
    "deployMistralOcr": { "value": "${DEPLOY_MISTRAL_OCR=true}" },
    "deployClaude": { "value": "${DEPLOY_CLAUDE=false}" },
    "disableLocalAuth": { "value": "${DISABLE_LOCAL_AUTH=true}" },
    "assignRbac": { "value": "${ASSIGN_RBAC=true}" },
    "enableContentUnderstanding": { "value": "${ENABLE_CONTENT_UNDERSTANDING=true}" },
    "cuEmbeddingModel": { "value": "${CU_EMBEDDING_MODEL=text-embedding-3-small}" },
    "claudeOrganizationName": { "value": "${CLAUDE_ORGANIZATION_NAME=}" },
    "claudeCountryCode": { "value": "${CLAUDE_COUNTRY_CODE=US}" },
    "claudeIndustry": { "value": "${CLAUDE_INDUSTRY=technology}" }
  }
}
