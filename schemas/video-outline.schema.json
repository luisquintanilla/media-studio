{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inert authored video outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "title", "text", "script"],
        "properties": {
          "kind": { "enum": ["Title", "Code", "Diagram"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "text": { "type": "string", "maxLength": 5000 },
          "script": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "illustrationPrompt": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
          "visual": { "oneOf": [{ "$ref": "project.schema.json#/$defs/visualTreatment" }, { "type": "null" }] },
          "motion": { "oneOf": [{ "$ref": "motion.schema.json" }, { "type": "null" }] }
        },
        "allOf": [
          {
            "if": { "required": ["visual"], "properties": { "visual": { "type": "object" } } },
            "then": { "properties": { "illustrationPrompt": { "type": "null" }, "kind": { "enum": ["Code", "Diagram"] } } }
          },
          {
            "if": { "required": ["motion"], "properties": { "motion": { "type": "object" } } },
            "then": { "properties": { "illustrationPrompt": { "type": "null" }, "visual": { "type": "null" }, "kind": { "const": "Diagram" } } }
          }
        ]
      }
    }
  },
  "description": "Deserialized strictly to Providers.VideoOutline and validated by ChatVideoPlanner.Validate plus Visuals.Validate. Caller constraints additionally bound scene count/word budget; resolved narration bounds reveal intervals. Text is inert, never executed. Optional visual is read-only structured trusted preset data, not HTML/CSS/JS."
}
